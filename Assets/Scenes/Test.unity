      gridColumns: 5
      gridRows: 5
      cellSize: 2
      furnitureRows:
      - X...X
      - ..X..
      - .....
      - ..X..
      - X...X
      editSeconds: 60
      surviveSeconds: 120
      lives: 3
      invincibleSeconds: 1.5
      mouseSpeed: 5
      mouseKnockback: 2.5
      catBaseSpeed: 3
      catMaxSpeed: 6.5
      catAcceleration: 0.35
      catchRadius: 0.6
      catStartDistance: 4.5
