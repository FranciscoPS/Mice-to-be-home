  traps:
  - displayName: Yarn Ball
    description: Rolls around and grabs the cat's attention.
    effectSeconds: 3
    gridSize: 1
    distractionRadius: 1.6
    sprite: {fileID: 0}
    tint: {r: 0.91, g: 0.42, b: 0.57, a: 1}
  - displayName: Toy Mouse
    description: A quick, cheap decoy.
    effectSeconds: 2
    gridSize: 1
    distractionRadius: 1.6
    sprite: {fileID: 0}
    tint: {r: 0.6, g: 0.63, b: 0.65, a: 1}
  - displayName: Cardboard Box
    description: Irresistible - the cat just has to climb in.
    effectSeconds: 3
    gridSize: 2
    distractionRadius: 2
    sprite: {fileID: 0}
    tint: {r: 0.76, g: 0.57, b: 0.35, a: 1}
  - displayName: Tuna Can
    description: The smell keeps it busy for a good while.
    effectSeconds: 5
    gridSize: 1
    distractionRadius: 1.6
    sprite: {fileID: 0}
    tint: {r: 0.5, g: 0.7, b: 0.84, a: 1}
  - displayName: Scratching Post
    description: It loves sharpening its claws here.
    effectSeconds: 4
    gridSize: 2
    distractionRadius: 2
    sprite: {fileID: 0}
    tint: {r: 0.85, g: 0.7, b: 0.35, a: 1}
  - displayName: Catnip
    description: Leaves it dazed for several seconds.
    effectSeconds: 5
    gridSize: 1
    distractionRadius: 1.6
    sprite: {fileID: 0}
    tint: {r: 0.5, g: 0.69, b: 0.41, a: 1}
  - displayName: Feather Wand
    description: Dances in the air and hypnotizes it.
    effectSeconds: 3
    gridSize: 2
    distractionRadius: 2
    sprite: {fileID: 0}
    tint: {r: 0.69, g: 0.52, b: 0.8, a: 1}
  - displayName: Toy Bird
    description: Chirps and hops to steal its attention.
    effectSeconds: 3
    gridSize: 1
    distractionRadius: 1.6
